{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/seo-article.js": {
      "includeFiles": "{seo-data.js,api/_data/seo-article-i18n.json}"
    },
    "api/prerender.js": {
      "includeFiles": "{localized.html,localized-secondary.html,localized-articles.html,category.html,formation-conseil.html,partenaires.html,emploi.html,category-translations.js,formation-conseil-i18n.js,corporate-pages-i18n.js,public-forms.js}"
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.dyonysos.fr" }],
      "destination": "https://dyonysos.fr/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.dyonysos.fr" }],
      "destination": "https://dyonysos.fr/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/dyonysos-maquette-entreprise-v2"
    },
    {
      "source": "/solutions",
      "destination": "/dyonysos-solutions-v2"
    },
    {
      "source": "/en",
      "destination": "/api/prerender?p=/en"
    },
    {
      "source": "/en/solutions",
      "destination": "/api/prerender?p=/en/solutions"
    },
    {
      "source": "/es",
      "destination": "/api/prerender?p=/es"
    },
    {
      "source": "/es/solutions",
      "destination": "/api/prerender?p=/es/solutions"
    },
    {
      "source": "/nl",
      "destination": "/api/prerender?p=/nl"
    },
    {
      "source": "/nl/solutions",
      "destination": "/api/prerender?p=/nl/solutions"
    },
    {
      "source": "/de",
      "destination": "/api/prerender?p=/de"
    },
    {
      "source": "/de/solutions",
      "destination": "/api/prerender?p=/de/solutions"
    },
    {
      "source": "/blog",
      "destination": "/api/seo-article?page=blog"
    },
    {
      "source": "/en/blog",
      "destination": "/api/seo-article?page=blog&lang=en"
    },
    {
      "source": "/es/blog",
      "destination": "/api/seo-article?page=blog&lang=es"
    },
    {
      "source": "/nl/blog",
      "destination": "/api/seo-article?page=blog&lang=nl"
    },
    {
      "source": "/de/blog",
      "destination": "/api/seo-article?page=blog&lang=de"
    },
    {
      "source": "/en/contact",
      "destination": "/api/prerender?p=/en/contact"
    },
    {
      "source": "/es/contact",
      "destination": "/api/prerender?p=/es/contact"
    },
    {
      "source": "/nl/contact",
      "destination": "/api/prerender?p=/nl/contact"
    },
    {
      "source": "/de/contact",
      "destination": "/api/prerender?p=/de/contact"
    },
    {
      "source": "/en/legal",
      "destination": "/api/prerender?p=/en/legal"
    },
    {
      "source": "/es/legal",
      "destination": "/api/prerender?p=/es/legal"
    },
    {
      "source": "/nl/legal",
      "destination": "/api/prerender?p=/nl/legal"
    },
    {
      "source": "/de/legal",
      "destination": "/api/prerender?p=/de/legal"
    },
    {
      "source": "/partenaires",
      "destination": "/partenaires"
    },
    {
      "source": "/en/partenaires",
      "destination": "/api/prerender?p=/en/partenaires"
    },
    {
      "source": "/es/partenaires",
      "destination": "/api/prerender?p=/es/partenaires"
    },
    {
      "source": "/nl/partenaires",
      "destination": "/api/prerender?p=/nl/partenaires"
    },
    {
      "source": "/de/partenaires",
      "destination": "/api/prerender?p=/de/partenaires"
    },
    {
      "source": "/emploi",
      "destination": "/emploi"
    },
    {
      "source": "/en/emploi",
      "destination": "/api/prerender?p=/en/emploi"
    },
    {
      "source": "/es/emploi",
      "destination": "/api/prerender?p=/es/emploi"
    },
    {
      "source": "/nl/emploi",
      "destination": "/api/prerender?p=/nl/emploi"
    },
    {
      "source": "/de/emploi",
      "destination": "/api/prerender?p=/de/emploi"
    },
    {
      "source": "/formation-conseil",
      "destination": "/formation-conseil"
    },
    {
      "source": "/en/formation-conseil",
      "destination": "/api/prerender?p=/en/formation-conseil"
    },
    {
      "source": "/es/formation-conseil",
      "destination": "/api/prerender?p=/es/formation-conseil"
    },
    {
      "source": "/nl/formation-conseil",
      "destination": "/api/prerender?p=/nl/formation-conseil"
    },
    {
      "source": "/de/formation-conseil",
      "destination": "/api/prerender?p=/de/formation-conseil"
    },
    {
      "source": "/en/blog/articles",
      "destination": "/api/prerender?p=/en/blog/articles"
    },
    {
      "source": "/es/blog/articles",
      "destination": "/api/prerender?p=/es/blog/articles"
    },
    {
      "source": "/nl/blog/articles",
      "destination": "/api/prerender?p=/nl/blog/articles"
    },
    {
      "source": "/de/blog/articles",
      "destination": "/api/prerender?p=/de/blog/articles"
    },
    {
      "source": "/emploi-carriere",
      "destination": "/api/prerender?p=/emploi-carriere"
    },
    {
      "source": "/education",
      "destination": "/api/prerender?p=/education"
    },
    {
      "source": "/commerce",
      "destination": "/api/prerender?p=/commerce"
    },
    {
      "source": "/gestion",
      "destination": "/api/prerender?p=/gestion"
    },
    {
      "source": "/marketplaces",
      "destination": "/api/prerender?p=/marketplaces"
    },
    {
      "source": "/video",
      "destination": "/api/prerender?p=/video"
    },
    {
      "source": "/graphisme",
      "destination": "/api/prerender?p=/graphisme"
    },
    {
      "source": "/annuaire",
      "destination": "/api/prerender?p=/annuaire"
    },
    {
      "source": "/createurs",
      "destination": "/api/prerender?p=/createurs"
    },
    {
      "source": "/applications",
      "destination": "/api/prerender?p=/applications"
    },
    {
      "source": "/en/:category(emploi-carriere|education|commerce|gestion|marketplaces|video|graphisme|annuaire|createurs|applications)",
      "destination": "/api/prerender?p=/en/:category"
    },
    {
      "source": "/es/:category(emploi-carriere|education|commerce|gestion|marketplaces|video|graphisme|annuaire|createurs|applications)",
      "destination": "/api/prerender?p=/es/:category"
    },
    {
      "source": "/nl/:category(emploi-carriere|education|commerce|gestion|marketplaces|video|graphisme|annuaire|createurs|applications)",
      "destination": "/api/prerender?p=/nl/:category"
    },
    {
      "source": "/de/:category(emploi-carriere|education|commerce|gestion|marketplaces|video|graphisme|annuaire|createurs|applications)",
      "destination": "/api/prerender?p=/de/:category"
    },
    {
      "source": "/solutions/:product(cvdesignpro|quizplay|courshub|ecole-connect|firmoscope|arbitrage-plus|analyzer-plus|profit-plus|erpbridge|marketplace|creation-graphique|applications-mobiles)",
      "destination": "/api/seo-article?page=product&slug=:product"
    },
    {
      "source": "/:lang(en|es|nl|de)/solutions/:product(cvdesignpro|quizplay|courshub|ecole-connect|firmoscope|arbitrage-plus|analyzer-plus|profit-plus|erpbridge|marketplace|creation-graphique|applications-mobiles)",
      "destination": "/api/seo-article?page=product&lang=:lang&slug=:product"
    },
    {
      "source": "/blog/articles",
      "destination": "/articles"
    },
    {
      "source": "/blog/applications-mobiles",
      "destination": "/mobile-articles"
    },
    {
      "source": "/odoo",
      "destination": "/odoo-apps"
    },
    {
      "source": "/applications-odoo",
      "destination": "/odoo-apps"
    },
    {
      "source": "/blog/odoo/:slug",
      "destination": "/api/odoo-app?slug=:slug"
    },
    {
      "source": "/blog/:article",
      "destination": "/api/seo-article?slug=:article"
    },
    {
      "source": "/:lang(en|es|nl|de)/blog/:article",
      "destination": "/api/seo-article?lang=:lang&slug=:article"
    },
    {
      "source": "/out/:solution",
      "destination": "/out"
    },
    {
      "source": "/contact",
      "destination": "/contact"
    },
    {
      "source": "/espace-prive",
      "destination": "/espace-prive"
    },
    {
      "source": "/pilotage-social",
      "destination": "/pilotage-social"
    },
    {
      "source": "/pilotage-odoo",
      "destination": "/api/pilotage-odoo-page"
    },
    {
      "source": "/pilotage-arbitragepro",
      "destination": "/api/pilotage-arbitragepro-page"
    },
    {
      "source": "/pilotage-portefeuille",
      "destination": "/api/pilotage-portefeuille-page"
    },
    {
      "source": "/pilotage-agoeon",
      "destination": "/api/pilotage-project-page?slug=agoeon"
    },
    {
      "source": "/pilotage-linktrib",
      "destination": "/api/pilotage-project-page?slug=linktrib"
    },
    {
      "source": "/pilotage-etsy",
      "destination": "/api/pilotage-project-page?slug=etsy"
    }
  ],
  "headers": [
    {
      "source": "/:lang(en|es|nl|de)/:path*",
      "headers": [
        {
          "key": "Link",
          "value": "<https://dyonysos.fr/:lang/:path*>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/solutions/:product",
      "headers": [
        {
          "key": "Link",
          "value": "<https://dyonysos.fr/solutions/:product>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/blog/:article",
      "headers": [
        {
          "key": "Link",
          "value": "<https://dyonysos.fr/blog/:article>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/common.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/common.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/i18n-health",
      "schedule": "17 3 * * *"
    }
  ]
}
